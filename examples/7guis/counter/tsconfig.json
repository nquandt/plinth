{
  // Generated by plinth. The closed world (SPEC.md §4.1): no ECMAScript
  // library, no ambient types, and `plinth:*` maps to the Plinth typings.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noLib": true,
    "types": [],
    "jsx": "preserve",
    "noEmit": true,
    "paths": { "plinth:*": ["../../../std/*"] }
  },
  "include": ["app/**/*", "../../../std/lib.d.ts"]
}
