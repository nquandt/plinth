// Plinth guest <-> host contract (SPEC.md §8).
//
// M0 contains only the UI interface. The host API interfaces (store, fs,
// net, time, clipboard, notify, dialog, locale, canvas) come in M2.
package plinth:app@1.0.0;

interface ui {
  /// Applies one batched op buffer (SPEC.md §8.2). The host applies each
  /// commit atomically.
  commit: func(ops: list<u8>);
}

/// Development output. `console.log` in `plinth:core` uses it. Release
/// builds of the host can drop the messages.
interface dev {
  log: func(msg: string);
}

/// A fallible-call error (SPEC.md §8.5, §11). `denied` covers every
/// capability-policy rejection; the `reason` names which of the three
/// policy outcomes applied (`undeclared`, `refused`, `unsupported`,
/// SPEC.md §11).
interface error {
  enum denied-reason {
    /// The app's manifest does not declare the capability this call needs.
    undeclared,
    /// The capability is declared, but the user has not granted it (or
    /// has refused it) yet.
    refused,
    /// This host/platform build has no implementation for the capability.
    unsupported,
  }

  variant host-error {
    denied(denied-reason),
  }
}

/// Clocks and timers (SPEC.md §8.5; capability: none, always available).
interface time {
  use error.{host-error};

  /// Milliseconds since the Unix epoch, UTC. Not monotonic across host
  /// clock changes; use only for display and logging.
  now: func() -> u64;

  /// Monotonic milliseconds since an arbitrary, fixed origin. Always
  /// increases, even if the wall clock changes. Use this to measure
  /// elapsed time.
  monotonic-now: func() -> u64;

  /// Schedules a `timer` event (SPEC.md §8.4) after `ms` milliseconds.
  /// When `repeat` is true, the host reschedules the same timer after
  /// each firing until `cancel-timer` is called. Returns the timer id.
  set-timer: func(ms: u32, repeat: bool) -> result<u32, host-error>;

  /// Cancels a timer. Canceling an unknown or already-fired one-shot
  /// timer is not an error.
  cancel-timer: func(timer: u32);

  /// The local time zone's offset from UTC, in minutes east of UTC, at
  /// the instant `ms` (milliseconds since the Unix epoch). Negative west
  /// of UTC, e.g. `-300` for US Eastern Standard Time. Comes from the OS
  /// (`plinth:time`'s date/time additions, docs/GAPS.md gap #5); the web
  /// host uses `-Date.getTimezoneOffset()`.
  timezone-offset: func(ms: s64) -> s32;
}

/// A per-app key/value store (SPEC.md §8.5; capability: `store.kv`).
/// Calls are synchronous: SPEC.md §8.5 permits a synchronous kv get when
/// it is cache-backed, and this host keeps the whole store in memory
/// (backed by a file flushed on every write), so every call is fast.
interface store {
  use error.{host-error};

  /// Returns the value for `key`, or `none` if it is not set.
  kv-get: func(key: string) -> result<option<string>, host-error>;
  /// Sets `key` to `value`, replacing any existing value.
  kv-set: func(key: string, value: string) -> result<_, host-error>;
  /// Removes `key`. Removing a missing key is not an error.
  kv-delete: func(key: string) -> result<_, host-error>;
  /// Lists every key currently set, in no particular order.
  kv-keys: func() -> result<list<string>, host-error>;
}

/// The system clipboard (SPEC.md §8.5; capabilities: `clipboard.read`,
/// `clipboard.write`).
interface clipboard {
  use error.{host-error};

  /// Replaces the clipboard's text content.
  write-text: func(text: string) -> result<_, host-error>;
  /// Reads the clipboard's text content, or `none` if it holds no text
  /// (for example an image). This call is synchronous: clipboard reads on
  /// every target this host supports are fast and do not block on I/O.
  read-text: func() -> result<option<string>, host-error>;
}

/// Host-owned modal dialogs (SPEC.md §8.5; capability: none, this is UI,
/// not data access). Every call returns at once with a request id; the
/// user's answer arrives later through a `completion` event (SPEC.md
/// §8.4), decoded as the `result` the doc comment below describes.
interface dialog {
  /// Shows a message with an OK button. The completion `result` is
  /// `null`.
  alert: func(message: string) -> u32;
  /// Shows a message with OK and Cancel. The completion `result` is a
  /// `bool` (`true` for OK).
  confirm: func(message: string) -> u32;
  /// Shows a message with a text field, OK and Cancel. The completion
  /// `result` is the entered text, or `null` if the user canceled.
  prompt: func(message: string) -> u32;
}

/// HTTP fetch (SPEC.md §8.5, §11; capability: `net:<host>`, dynamic per
/// declared host, plus `net.local` for private network ranges). Every
/// call returns at once with a request id; the result arrives later
/// through a `completion` event (SPEC.md §8.4). A denied or failed call
/// never traps: it completes with an error result (SPEC.md §8.5).
interface net {
  /// `headers` is a list of `(name, value)` pairs. `body` is UTF-8 text
  /// only. The completion `result` is a 4-element list: `ok` (bool),
  /// `status` (s32), `text` (string), `error` (string, or null when `ok`).
  fetch: func(url: string, method: string, headers: list<tuple<string, string>>, body: option<string>) -> u32;
}

/// Privileged library and Hub management calls (`docs/HUB.md` §4.1, §12.2,
/// §12.3; capability: `hub.manage`, High risk). The host grants
/// `hub.manage` only to a package signed by a key it trusts as a Hub key
/// (`docs/HUB.md` §4.1); every other package that imports this interface
/// is refused at load, with a clear error, before it ever runs.
interface hub {
  use error.{host-error};

  /// Every app in the library, as a JSON array of objects (`docs/HUB.md`
  /// §9.1, §7.1): `id`, `name`, `version`, `signer` (the signer's key id,
  /// or `""` if unsigned), `blocked`, and `capabilities` (each `{name,
  /// risk, allowed}`, `risk` one of `"none"`/`"low"`/`"medium"`/`"high"`).
  /// Plinth TS has no guest-side struct marshaling yet, so this interface
  /// reuses the `JSON.parse` support `plinth:core` already has (SPEC.md
  /// §4.7) instead of adding one: `std/hub.d.ts` is typed, and decodes
  /// this string for the caller.
  list-apps: func() -> result<string, host-error>;
  /// Opens `id` in a new window, running the normal consent flow
  /// (`docs/HUB.md` §4.2, §7.3). Returns at once; the host opens the
  /// window on its own schedule; a slow or blocked open is not reported
  /// back to the guest (there is nothing it would do differently).
  launch: func(id: string) -> result<_, host-error>;
  /// Changes one capability grant for an installed app (`docs/HUB.md`
  /// §7.4).
  set-grant: func(id: string, capability: string, allowed: bool) -> result<_, host-error>;
  /// Blocks an app: it will not run until `unblock` (`docs/HUB.md` §7.4).
  block: func(id: string) -> result<_, host-error>;
  /// Reverses `block`.
  unblock: func(id: string) -> result<_, host-error>;

  // -- Core 1.8 (`docs/HUB.md` §9.1, §5.2, phase H3 step 2) ---------------

  /// The groups of the library (`docs/HUB.md` §9.1), as a JSON array of
  /// strings, in the order the user made them.
  list-groups: func() -> result<string, host-error>;
  /// Makes an empty group. A group that exists already is not an error.
  create-group: func(name: string) -> result<_, host-error>;
  /// Puts `id` in `group` (`member` true; this makes the group if
  /// necessary) or takes it out (`member` false).
  set-group: func(id: string, group: string, member: bool) -> result<_, host-error>;
  /// Removes an app from the library. Its data and grants stay.
  remove: func(id: string) -> result<_, host-error>;
  /// Searches every configured source (`docs/HUB.md` §5.2,
  /// `docs/REGISTRY.md` §9) on a worker thread. Returns a request id at
  /// once; the `completion` result is a JSON string `{ "hits": [{ id,
  /// name, version, description, source }], "errors": [string] }` (one
  /// error for each source that failed), or null if the call is denied.
  search: func(query: string) -> u32;
  /// Installs the latest version of `id` from the first configured source
  /// that lists it, on a worker thread. Returns a request id at once; the
  /// `completion` result is null on success, or an error string (for a
  /// denied call, `"denied:<reason>"`).
  install: func(id: string) -> u32;

  // -- Core 1.9 (`docs/HUB.md` §4.1, §7.4, §9.2) ----------------------------

  /// One library app, as a JSON object: the fields of a `list-apps`
  /// element. An error if `id` is not in the library.
  app-info: func(id: string) -> result<string, host-error>;
  /// Pins `id` to the installed `version` (`docs/HUB.md` §9.2); an empty
  /// `version` removes the pin, and the newest version runs again.
  pin: func(id: string, version: string) -> result<_, host-error>;
  /// Blocks the publisher key `key` (`ed25519:…`): no app that it signed
  /// runs or installs (`docs/HUB.md` §7.4).
  block-publisher: func(key: string) -> result<_, host-error>;
  /// Reverses `block-publisher`.
  unblock-publisher: func(key: string) -> result<_, host-error>;
  /// Checks the source of `id` (of every library app if `id` is empty) for
  /// a newer version, on a worker thread (`docs/HUB.md` §9.2). Returns a
  /// request id at once; the `completion` result is a JSON string `{
  /// "updates": [{ id, name, current, version, source, newCapabilities,
  /// pinned }], "errors": [string] }`, or null if the call is denied.
  check-updates: func(id: string) -> u32;
  /// Installs the newest version of library app `id` from its source, on a
  /// worker thread. The new version runs after the user decides its new
  /// capabilities (`docs/HUB.md` §7.3 step 3). Returns a request id at
  /// once; the `completion` result is null on success (also when `id` is
  /// up to date), or an error string (`"denied:<reason>"` if denied).
  update: func(id: string) -> u32;
}

world app {
  import ui;
  import dev;
  import time;
  import store;
  import clipboard;
  import dialog;
  import net;
  import hub;

  /// Builds the initial tree.
  export init: func(args: list<u8>);
  /// Handles one or more batched events (SPEC.md §8.4).
  export on-event: func(ev: list<u8>);
}
