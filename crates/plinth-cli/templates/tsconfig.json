{
  // Generated by `plinth new`. "noLib" and "types": [] make the closed world
  // (SPEC.md §4.1): only the plinth:* modules exist. `plinth` refreshes the
  // typings in .plinth/types on each run.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noLib": true,
    "types": [],
    "jsx": "preserve",
    "noEmit": true,
    "paths": { "plinth:*": ["./.plinth/types/*"] }
  },
  "include": ["app/**/*", ".plinth/types/lib.d.ts"]
}
